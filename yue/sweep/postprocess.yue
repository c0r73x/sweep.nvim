-- Post-processing of raw model output (pure functions, no Neovim state)

-- Special tokens that may leak into the text (stop strings are already
-- removed by the server)
strip_special = (text) ->
    text = text\gsub('<|[%w_]+|>', '')
    (text\gsub('</s>', ''))

trim = (s) -> s\match('^%s*(.-)%s*$')

indent = (line) -> #line\match('^%s*')

-- Lines at the cursor's indent that continue the block it opens, or
-- close it (kept, then the completion ends)
CONTINUERS = {'^else%f[^%w_]', '^elif%f[^%w_]', '^elseif%f[^%w_]', '^except%f[^%w_]', '^catch%f[^%w_]',
    '^finally%f[^%w_]', '^}%s*else%f[^%w_]', '^}%s*catch%f[^%w_]'}
CLOSERS = {'^[%}%)%]]', '^end%f[^%w_]'}

matches = (s, patterns) ->
    for pat in *patterns
        return true if s\find(pat)
    false

-- Where a FIM completion may end, from the text around the cursor.
-- before/after: the cursor line split at the cursor; below: the lines
-- that follow it. Kinds:
--   line:  text after the cursor (or the block below already has its
--          body): complete this line only
--   body:  empty line at the end of a block: lines while they stay at
--          the cursor's indent or deeper
--   block: this line plus the block it opens (deeper lines, else/catch
--          continuations and one closing line at the cursor's indent)
-- max_lines caps all kinds.
fim_scope = (before, after, below, max_lines=8) ->
    base = indent(before)
    nxt = nil
    for l in *(below or {})
        if l\find('%S')
            nxt = l
            break
    kind = if after\find('%S') or (nxt and indent(nxt) > base)
        'line'
    elseif not before\find('%S') and (not nxt or indent(nxt) < base)
        'body'
    else
        'block'
    -- at_end: nothing follows in this block, so new statements may
    -- continue it
    { :kind, :base, :max_lines, at_end: not nxt or indent(nxt) < base }

-- A block completion whose first line is blank finishes the cursor's
-- line and starts on the next one (the blank line is not counted)
starts_below = (lines, scope) ->
    scope.kind == 'block' and #lines > 1 and not lines[1]\find('%S')

line_limit = (lines, scope) ->
    return 1 if scope.kind == 'line'
    scope.max_lines + (starts_below(lines, scope) and 1 or 0)

-- Lines of a FIM completion to keep, and whether its end was found.
-- Only lines 2..n_complete are judged (a streamed last line may grow).
fim_cut = (lines, scope, n_complete=#lines) ->
    keep = math.min(1, #lines)
    limit = line_limit(lines, scope)
    kind = scope.kind
    -- Below a finished line, the first line at the cursor's indent is a
    -- new statement, cut like one typed on a fresh line
    started = not starts_below(lines, scope)
    for i = 2, n_complete
        return keep, true if kind == 'line' or keep >= limit
        line = lines[i]
        s = trim(line)
        if s == ''
            keep = i
            continue
        ind = indent(line)
        return keep, true if ind < scope.base
        unless started
            started = true
            kind = 'body' if ind == scope.base and scope.at_end
            keep = i
            continue
        if ind == scope.base and kind == 'block'
            if matches(s, CONTINUERS)
                keep = i
                continue
            keep = i if matches(s, CLOSERS)
            return keep, true
        keep = i
    keep, false

DEFAULT_SCOPE = { kind: 'block', base: 0, max_lines: 8, at_end: true }

-- Should a FIM stream stop now? Once a finished line ends the
-- completion, a new line dedents past the cursor, or the cap is hit.
fim_should_stop = (text, scope=DEFAULT_SCOPE) ->
    lines = vim.split(text, '\n', { plain: true })
    return true if #lines > line_limit(lines, scope)
    _, done = fim_cut(lines, scope, #lines - 1)
    return true if done
    last = lines[#lines]
    #lines > 1 and last\find('%S') ~= nil and indent(last) < scope.base

-- FIM text is inserted verbatim at the cursor, so leading whitespace is
-- kept. truncated: generation was cut (token limit or early stop), so the
-- last line may be partial.
post_process_fim = (text, truncated, scope=DEFAULT_SCOPE) ->
    return '' unless text and text ~= ''
    text = strip_special(text)
    lines = vim.split(text, '\n', { plain: true })
    table.remove(lines) if truncated and #lines > 1
    keep = fim_cut(lines, scope)
    (table.concat([l for l in *lines[1, keep]], '\n')\gsub('%s+$', ''))

-- Hunks between two line lists: { start_a, count_a, start_b, count_b }
-- (a count of 0 means an insertion/deletion after line start)
diff_hunks = (a, b) ->
    return {} if #a == 0 and #b == 0
    sa = #a > 0 and table.concat(a, '\n') .. '\n' or ''
    sb = #b > 0 and table.concat(b, '\n') .. '\n' or ''
    vim.diff(sa, sb, { result_type: 'indices', algorithm: 'histogram' })

-- Apply hunks (ascending, from diff_hunks(old, new)) to old
apply_hunks = (old, new, hunks) ->
    out = {}
    pos = 1
    for h in *hunks
        sa, ca, sb, cb = h[1], h[2], h[3], h[4]
        first = ca == 0 and sa + 1 or sa
        for i = pos, first - 1
            table.insert(out, old[i])
        for j = sb, sb + cb - 1
            table.insert(out, new[j]) if cb > 0
        pos = first + ca
    for i = pos, #old
        table.insert(out, old[i])
    out

-- Old-side line span of a hunk (insertions touch the lines around them)
hunk_span = (h) ->
    if h[2] == 0
        h[1], h[1] + 1
    else
        h[1], h[1] + h[2] - 1

-- Window lines the user changed since the original snapshot: a set of
-- current-side line numbers, and the trimmed text of lines they deleted
edited_lines = (original, current) ->
    edited, deleted = {}, {}
    return edited, deleted unless original and current
    for h in *diff_hunks(original, current)
        if h[4] > 0
            for i = h[3], h[3] + h[4] - 1
                edited[i] = true
        else
            for i = h[1], h[1] + h[2] - 1
                l = trim(original[i])
                deleted[l] = true if #l > 0
    edited, deleted

-- Current-side line spans { lo, hi } of the user's change since the
-- original (a deletion covers the lines around it)
edit_spans = (original, current) ->
    spans = {}
    return spans unless original and current
    for h in *diff_hunks(original, current)
        if h[4] > 0
            table.insert(spans, { h[3], h[3] + h[4] - 1 })
        else
            table.insert(spans, { h[3], h[3] + 1 })
    spans

-- A model hunk that undoes the user's change: it rewrites a line they
-- just edited (adding text after what they typed is fine, e.g. a comma
-- and the next entry), or puts back only lines they just deleted
reverts_edit = (h, current, updated, edited, deleted) ->
    if h[2] > 0
        touches = false
        for i = h[1], h[1] + h[2] - 1
            touches = true if edited[i]
        if touches
            return true if h[4] < h[2]
            for k = 0, h[2] - 1
                cur, upd = current[h[1] + k], updated[h[3] + k]
                return true unless upd\sub(1, #cur) == cur
    if h[4] > 0 and next(deleted)
        restored = 0
        for k = 0, h[4] - 1
            l = trim(updated[h[3] + k])
            continue if #l == 0
            return false unless deleted[l]
            restored += 1
        return true if restored > 0
    false

-- Edit output is the rewritten window. Returns the window with only the
-- changes near the cursor applied, or nil when there is nothing to show.
-- truncated: generation hit the token limit, so the tail of the window is
-- missing; that missing tail is not an edit.
-- original_lines: the window before the user's change; hunks that undo
-- that change are dropped.
post_process_edit = (text, truncated, current_lines, cursor_offset=0, proximity=8, original_lines=nil) ->
    return nil unless text
    text = strip_special(text)
    -- The prompt ends with "<|file_sep|>updated/<path>": the output starts
    -- with that line's newline and usually ends with one before the next
    -- separator. Only those are dropped.
    text = text\gsub('^\r?\n', '')
    text = text\gsub('\n$', '')
    text = text\gsub('\r$', '')
    updated = text\match('%S') and vim.split(text, '\n', { plain: true }) or {}
    table.remove(updated) if truncated and #updated > 0
    -- No output means no prediction, not "delete the window"
    return nil if #updated == 0
    return updated unless current_lines and #current_lines > 0

    local hunks
    if truncated
        -- Compare with the same number of window lines. A line the model
        -- inserted (or deleted) then shifts the end, showing up as a
        -- trailing pure deletion (insertion), which is not a real edit.
        base = [l for l in *current_lines[1, math.min(#updated, #current_lines)]]
        hunks = diff_hunks(base, updated)
        last = hunks[#hunks]
        if last
            pure_del_at_end = last[4] == 0 and last[1] + last[2] - 1 >= #base
            pure_ins_at_end = last[2] == 0 and last[3] + last[4] - 1 >= #updated
            table.remove(hunks) if pure_del_at_end or pure_ins_at_end
    else
        hunks = diff_hunks(current_lines, updated)
    cursor = cursor_offset + 1
    edited, deleted = edited_lines(original_lines, current_lines)
    kept = {}
    for h in *hunks
        lo, hi = hunk_span(h)
        near = hi >= cursor - proximity and lo <= cursor + proximity
        if near and not reverts_edit(h, current_lines, updated, edited, deleted)
            table.insert(kept, h)
    return nil if #kept == 0
    apply_hunks(current_lines, updated, kept)

export default {
    :strip_special
    :fim_scope
    :fim_should_stop
    :post_process_fim
    :post_process_edit
    :edit_spans
    :diff_hunks
    :apply_hunks
}
