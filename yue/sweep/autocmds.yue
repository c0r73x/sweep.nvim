-- Autocommand Setup

api = vim.api

-- One uv timer per Sweep instance, reused for the TextChangedI debounce
-- and the CursorHold edit delay (restarting a timer is far cheaper than
-- creating and closing one per keystroke).
-- _timer_token invalidates callbacks that already fired but are still
-- waiting in the schedule queue when the timer is stopped/restarted.
-- _hold_fired stays set after a CursorHold request until the cursor moves,
-- so a stationary cursor doesn't re-trigger edit predictions.
start_timer = (ct, delay, fn) ->
    timer = ct._debounce_timer
    if not timer or timer\is_closing()
        timer = vim.uv.new_timer()
        ct._debounce_timer = timer
    token = (ct._timer_token or 0) + 1
    ct._timer_token = token
    ct._timer_armed = true
    timer\start(delay, 0, ->
        vim.schedule(->
            return unless ct._timer_token == token
            ct._timer_armed = false
            fn()
        )
    )

stop_timer = (ct) ->
    timer = ct._debounce_timer
    timer\stop() if timer and not timer\is_closing()
    ct._timer_token = (ct._timer_token or 0) + 1
    ct._timer_armed = false
    ct._hold_fired = false

-- Callback functions
text_changed_callback = () ->
    ct = _G.sweep
    return unless ct and ct.config.enabled

    -- The shown completion no longer matches the text
    ct\reject()

    delay = ct.config.behavior.text_change_debounce
    bufnr = api.nvim_get_current_buf()

    -- Buffer state is read in trigger_completion (after the debounce and
    -- the validity checks), not on every keystroke
    if delay > 0
        start_timer(ct, delay, ->
            return unless api.nvim_get_current_buf() == bufnr
            ct\trigger_completion(bufnr)
        )
    else
        stop_timer(ct)
        ct\trigger_completion(bufnr)

-- Normal mode text change (undo, paste, ...): predictions are stale
text_changed_normal_callback = () ->
    ct = _G.sweep
    return unless ct
    ct\reject()

-- Insert mode cursor move: FIM ghost text is only valid at its position
cursor_moved_insert_callback = () ->
    ct = _G.sweep
    return unless ct
    gt = ct.ghost_text
    return unless gt and gt.visible
    pos = api.nvim_win_get_cursor(0)
    unless api.nvim_get_current_buf() == gt.current_bufnr and
            pos[1] == gt.current_line and pos[2] == gt.current_col
        ct\reject()

insert_enter_callback = () ->
    ct = _G.sweep
    return unless ct
    bufnr = api.nvim_get_current_buf()
    -- Clear any existing edit predictions when entering insert mode
    ct\reject()
    stop_timer(ct)
    -- Snapshot original state for sweep prompt (original vs current)
    ct.buffer_state\snapshot_original(bufnr)

insert_leave_callback = () ->
    ct = _G.sweep
    return unless ct
    -- Clear all ghost text when leaving insert mode
    ct\reject()
    -- Also clear any pending debounce timers
    stop_timer(ct)

mode_changed_callback = () ->
    ct = _G.sweep
    return unless ct
    mode = vim.api.nvim_get_mode().mode
    -- Clear ghost text when entering normal/visual/command modes
    -- Ghost text should only appear in insert mode
    if mode ~= 'i'
        ct\reject()

cursor_moved_normal_callback = () ->
    ct = _G.sweep
    return unless ct and ct.config.enabled

    -- Hide edit predictions when cursor moves (only in normal mode)
    mode = vim.api.nvim_get_mode().mode
    if mode == 'n' and ct.config.behavior.hide_on_cursor_move
        ct\reject()

    -- Clear debounce timer when cursor moves
    stop_timer(ct)

cursor_hold_callback = () ->
    ct = _G.sweep
    return unless ct and ct.config.enabled

    -- Only trigger edit prediction if:
    -- 1. We're in normal mode
    -- 2. No edit prediction is currently showing
    -- 3. Not already processing a request
    mode = vim.api.nvim_get_mode().mode
    return unless mode == 'n'
    return if ct\is_processing()
    return if ct.ghost_text\has_cursor_prediction()

    -- Don't trigger if a timer is pending or already fired at this spot
    return if ct._timer_armed or ct._hold_fired

    -- Use edit prediction delay (default 1000ms)
    delay = ct.config.behavior.edit_prediction_delay or 1000

    bufnr = api.nvim_get_current_buf()
    return unless ct.buffer_state\is_valid_buffer(bufnr)
    -- Only snapshot if we don't already have one from InsertEnter.
    -- Overwriting would make original == current, losing the pre-edit baseline.
    state = ct.buffer_state.buffer_states[bufnr]
    unless state and state.original_all_lines
        ct.buffer_state\snapshot_original(bufnr)

    start_timer(ct, delay, ->
        ct._hold_fired = true
        -- Double-check we're still in normal mode and not processing
        if api.nvim_get_current_buf() == bufnr and
                vim.api.nvim_get_mode().mode == 'n' and not ct\is_processing()
            ct\trigger_completion(bufnr)
    )

buf_enter_callback = () ->
    ct = _G.sweep
    return unless ct
    bufnr = api.nvim_get_current_buf()
    -- Attach tracker to this buffer (tracks line changes for edit history)
    ct.tracker\attach(bufnr)
    -- Record as recently visited for context files
    ct.tracker\track_visit(bufnr)

buf_leave_callback = () ->
    ct = _G.sweep
    return unless ct
    ct\reject()
    stop_timer(ct)
    -- Only clear transient window state, preserve original_all_lines
    -- so edit mode retains its baseline across buffer switches
    bufnr = api.nvim_get_current_buf()
    state = ct.buffer_state.buffer_states[bufnr]
    if state
        state.current_window = nil

-- Autocmd callbacks that return a truthy value are deleted (and Yue
-- returns the last expression implicitly), so never return anything
no_return = (fn) -> (args) ->
    fn(args)
    return

-- Check port availability asynchronously
check_port_listening = (port, on_listening, on_free) ->
    client = vim.uv.new_tcp()
    client\connect('127.0.0.1', port, (err) ->
        if err
            client\close()
            vim.schedule(on_free) if on_free
        else
            client\close()
            vim.schedule(on_listening) if on_listening
    )

proxy_exit_callback = (job_id, code) ->
    if code ~= 0
        ct = _G.sweep
        proxy_url = ct and ct.config.provider.url or 'http://127.0.0.1:5555'
        url_parts = vim.split(proxy_url, '://')[2]
        port = tonumber(vim.split(url_parts, ':')[2]) or 5555

        check_port_listening(port,
            (-> return),
            (-> vim.notify("Sweep: Sweep proxy exited - model file not found or dependencies missing", vim.log.levels.WARN))
        )

-- Poll every 500ms until the proxy socket exists, then health-check it
wait_for_socket = (ct, tries) ->
    if vim.uv.fs_stat(ct.client.sock_path)
        ct.client\health_check()
    elseif tries > 0
        vim.defer_fn((-> wait_for_socket(ct, tries - 1)), 500)
    else
        ct.client\health_check()

very_lazy_callback = () ->
    ct = _G.sweep
    return unless ct and ct.config.enabled

    unless ct.config.provider.auto_start
        ct.client\health_check()
        return

    proxy_url = ct.config.provider.url
    url_parts = vim.split(proxy_url, '://')[2]
    port = tonumber(vim.split(url_parts, ':')[2]) or 5555

    check_port_listening(port,
        (->
            -- Proxy already running, warm up connection with health check
            ct.client\health_check()
        ),
        (->
            proxy_script = ct.config.provider.proxy_script
            if vim.uv.fs_stat(proxy_script)
                job_opts = {
                    detach: true
                    on_exit: proxy_exit_callback
                }
                env = vim.deepcopy(ct.config.provider.env or {})
                model_path = ct.config.provider.model_path
                env.MODEL_PATH = model_path if model_path
                job_opts.env = env if next(env)
                vim.fn.jobstart({'python3', proxy_script}, job_opts)
                -- Warm up once the socket appears (the proxy binds it before
                -- loading the model), rather than guessing a fixed delay
                wait_for_socket(ct, 60)
        )
    )

export default {
    stop_timer: stop_timer

    setup_autocmds: (sweep) ->
        augroup = api.nvim_create_augroup('sweep', { clear: true })

        api.nvim_create_autocmd('TextChangedI', {
            group: augroup
            callback: no_return(text_changed_callback)
        })

        api.nvim_create_autocmd('TextChanged', {
            group: augroup
            callback: no_return(text_changed_normal_callback)
        })

        api.nvim_create_autocmd('CursorMovedI', {
            group: augroup
            callback: no_return(cursor_moved_insert_callback)
        })

        api.nvim_create_autocmd('InsertEnter', {
            group: augroup
            callback: no_return(insert_enter_callback)
        })

        api.nvim_create_autocmd('InsertLeave', {
            group: augroup
            callback: no_return(insert_leave_callback)
        })

        api.nvim_create_autocmd('ModeChanged', {
            group: augroup
            callback: no_return(mode_changed_callback)
        })

        api.nvim_create_autocmd('CursorHold', {
            group: augroup
            callback: no_return(cursor_hold_callback)
        })

        api.nvim_create_autocmd('CursorMoved', {
            group: augroup
            callback: no_return(cursor_moved_normal_callback)
        })

        api.nvim_create_autocmd('BufEnter', {
            group: augroup
            callback: no_return(buf_enter_callback)
        })

        api.nvim_create_autocmd('BufLeave', {
            group: augroup
            callback: no_return(buf_leave_callback)
        })

        api.nvim_create_autocmd('User', {
            group: augroup
            pattern: 'VeryLazy'
            callback: no_return(very_lazy_callback)
        })

        -- If VeryLazy already fired (plugin loaded by VeryLazy event),
        -- the autocmd above will never trigger. Run startup logic now.
        if vim.v.vim_did_enter == 1
            vim.schedule(very_lazy_callback)
}
