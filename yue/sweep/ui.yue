-- Completion UI Rendering
-- Supports both FIM (inline ghost text) and edit (diff-based) modes

api = vim.api
Diff = require('sweep.diff')

-- Split s after `cells` display cells. A character crossing the boundary
-- goes to the head with round_up, else to the tail. Returns head, tail
-- and the head's width.
split_cells = (s, cells, round_up) ->
    width, i = 0, 1
    while i <= #s
        break if round_up and width >= cells
        n = vim.str_utf_end(s, i) + 1
        w = vim.fn.strdisplaywidth(s\sub(i, i + n - 1))
        break if not round_up and width + w > cells
        width += w
        i += n
    s\sub(1, i - 1), s\sub(i), width

export default class GhostText
    config: nil
    ns_id: nil
    visible: false
    blink_menu_visible: false
    show_time: 0
    -- Current state
    mode: nil           -- 'fim' | 'edit'
    current_bufnr: nil
    current_line: nil
    current_col: nil
    -- FIM mode state
    current_completion: nil
    -- Edit mode state
    current_context: nil
    current_updated_lines: nil
    current_diff: nil
    -- Extmark tracking
    extmark_ids: {}

    new: (config) =>
        @config = config
        @ns_id = api.nvim_create_namespace('sweep_ghost')
        @visible = false
        @blink_menu_visible = false
        @show_time = 0
        @mode = nil
        @current_bufnr = nil
        @current_line = nil
        @current_col = nil
        @current_completion = nil
        @current_context = nil
        @current_updated_lines = nil
        @current_diff = nil
        @extmark_ids = {}
        @setup_blink_listeners() if config.blink.enabled

    -- ---------------------------------------------------------------
    -- FIM mode: show inline ghost text at cursor
    -- ---------------------------------------------------------------
    show_fim: (completion, context) =>
        return unless completion and #completion > 0
        return unless context
        return if @should_hide_for_blink()

        @hide()

        bufnr = context.bufnr or api.nvim_get_current_buf()
        line_num = context.line_num or api.nvim_win_get_cursor(0)[1]
        col = context.cursor_col or api.nvim_win_get_cursor(0)[2]

        -- Clamp column
        line = api.nvim_buf_get_lines(bufnr, line_num - 1, line_num, false)[1] or ''
        col = math.min(col, #line)

        -- Split completion into lines
        comp_lines = vim.split(completion, '\n')
        first_line = comp_lines[1] or ''
        return unless #first_line > 0 or #comp_lines > 1

        @mode = 'fim'
        @current_completion = completion
        @current_context = context
        @current_bufnr = bufnr
        @current_line = line_num
        @current_col = col

        -- Build extmark options
        extmark_opts = {
            virt_text: {{first_line, 'SweepCompletion'}}
            virt_text_pos: 'inline'
            hl_mode: 'combine'
        }

        -- Multi-line: add virtual lines below
        if #comp_lines > 1
            virt_lines = {}
            for i = 2, #comp_lines
                table.insert(virt_lines, {{comp_lines[i], 'SweepCompletion'}})
            extmark_opts.virt_lines = virt_lines

        id = api.nvim_buf_set_extmark(bufnr, @ns_id, line_num - 1, col, extmark_opts)
        table.insert(@extmark_ids, id)
        @visible = true
        @show_time = vim.uv.hrtime()

    -- ---------------------------------------------------------------
    -- Edit mode: show diff-based changes
    -- ---------------------------------------------------------------
    show_edit: (updated_lines, context) =>
        return unless updated_lines and #updated_lines > 0
        return unless context
        return if @should_hide_for_blink()

        current_lines = context.current_lines or {}
        diff_result = Diff.diff(current_lines, updated_lines)
        return unless diff_result.has_changes

        @hide()

        @mode = 'edit'
        @current_context = context
        @current_updated_lines = updated_lines
        @current_diff = diff_result
        @current_bufnr = context.bufnr or api.nvim_get_current_buf()
        @current_line = context.line_num
        @current_col = context.cursor_col

        window_start = context.window_start or 1

        for _, hunk in ipairs(diff_result.hunks)
            @render_hunk(hunk, window_start)

        if #@extmark_ids > 0
            @visible = true
            @show_time = vim.uv.hrtime()

    -- Walk the hunk in display order: paired lines get their inline
    -- changes, unpaired deleted lines are highlighted, and added lines
    -- become virtual lines below the old line they follow (above the
    -- first line when inserting at the buffer top)
    render_hunk: (hunk, window_start) =>
        bufnr = @current_bufnr
        total_lines = api.nvim_buf_line_count(bufnr)
        -- 0-indexed buffer row of the hunk's first old line
        first_row = (window_start - 1) + (hunk.old_start - 1)
        consumed = 0
        pending = {}

        flush = ->
            return if #pending == 0
            @render_virt_lines(bufnr, first_row + consumed - 1, pending, total_lines)
            pending = {}

        for item in *hunk.items
            if item.kind == 'add'
                table.insert(pending, hunk.adds[item.new])
            else
                flush()
                row = first_row + consumed
                if row >= 0 and row < total_lines
                    if item.kind == 'pair'
                        @render_inline(bufnr, row, item.changes)
                    else
                        @render_deleted_line(bufnr, row)
                consumed += 1
        flush()

    render_deleted_line: (bufnr, row) =>
        line_text = api.nvim_buf_get_lines(bufnr, row, row + 1, false)[1] or ''
        -- A zero-width range would be invisible on an empty line
        opts = if #line_text > 0
            { end_row: row, end_col: #line_text, hl_group: 'SweepDeletion', hl_mode: 'combine' }
        else
            { line_hl_group: 'SweepDeletion' }
        table.insert(@extmark_ids, api.nvim_buf_set_extmark(bufnr, @ns_id, row, 0, opts))

    -- Changes within a line: replaced text is drawn over the old text
    -- (what doesn't fit goes inline after it, old text left over is
    -- marked as deleted), removed text is marked as deleted and added
    -- text is shown inline
    render_inline: (bufnr, row, changes) =>
        line = api.nvim_buf_get_lines(bufnr, row, row + 1, false)[1] or ''
        for idx, change in ipairs(changes)
            col = math.min(change.col, #line)
            end_col = math.min(change.end_col, #line)
            old = line\sub(col + 1, end_col)
            new = change.text
            inline = new
            -- Tabs have no fixed width, so they are not overlaid
            if #old > 0 and #new > 0 and not (old .. new)\find('\t')
                old_w = vim.fn.strdisplaywidth(old)
                -- Shorter: the old text left over would read as part of
                -- the new one, so the rest of the line is redrawn
                if vim.fn.strdisplaywidth(new) < old_w and @render_rest(bufnr, row, line, changes, idx)
                    return
                head, tail, head_w = split_cells(new, old_w)
                under, _, under_w = split_cells(old, head_w, true)
                if #under > 0
                    @add_mark(bufnr, row, col, {
                        virt_text: {{head .. string.rep(' ', under_w - head_w), 'SweepAddition'}}
                        virt_text_pos: 'overlay'
                    })
                    col += #under
                    inline = tail
            if end_col > col
                @add_mark(bufnr, row, col, {
                    end_col: end_col
                    hl_group: 'SweepDeletion'
                    hl_mode: 'combine'
                })
            if #inline > 0
                @add_mark(bufnr, row, end_col, {
                    -- Not 'combine': that mixes in the syntax colour of
                    -- the text it is attached to
                    virt_text: {{inline, 'SweepAddition'}}
                    virt_text_pos: 'inline'
                })

    -- Draw the line from changes[first] on as it will be: one overlay
    -- over the old text (padded with spaces when shorter), anything
    -- wider than the old text inline at the end of the line. Text that
    -- only moves is redrawn in SweepAddition too, so the whole redrawn
    -- part reads as preview. false when tabs prevent it.
    render_rest: (bufnr, row, line, changes, first) =>
        start = math.min(changes[first].col, #line)
        chunks = {}
        pos = start
        for k = first, #changes
            c = changes[k]
            col = math.min(c.col, #line)
            table.insert(chunks, {line\sub(pos + 1, col), 'SweepAddition'}) if col > pos
            table.insert(chunks, {c.text, 'SweepAddition'}) if #c.text > 0
            pos = math.max(pos, math.min(c.end_col, #line))
        table.insert(chunks, {line\sub(pos + 1), 'SweepAddition'}) if pos < #line
        old_rest = line\sub(start + 1)
        return false if old_rest\find('\t')
        for chunk in *chunks
            return false if chunk[1]\find('\t')

        room = vim.fn.strdisplaywidth(old_rest)
        over, after = {}, {}
        for chunk in *chunks
            if #after > 0
                table.insert(after, chunk)
                continue
            head, tail, head_w = split_cells(chunk[1], room)
            table.insert(over, {head, chunk[2]}) if #head > 0
            room -= head_w
            table.insert(after, {tail, chunk[2]}) if #tail > 0
        table.insert(over, {string.rep(' ', room)}) if room > 0
        @add_mark(bufnr, row, start, { virt_text: over, virt_text_pos: 'overlay' })
        @add_mark(bufnr, row, #line, { virt_text: after, virt_text_pos: 'inline' }) if #after > 0
        true

    add_mark: (bufnr, row, col, opts) =>
        table.insert(@extmark_ids, api.nvim_buf_set_extmark(bufnr, @ns_id, row, col, opts))

    -- anchor: 0-indexed row the lines go below (-1 = above the first line)
    render_virt_lines: (bufnr, anchor, lines, total_lines) =>
        above = anchor < 0
        anchor = math.max(0, math.min(anchor, total_lines - 1))

        virt_lines = {}
        for add_line in *lines
            -- Empty strings don't render in virt_lines, use a space instead
            display_line = #add_line > 0 and add_line or ' '
            table.insert(virt_lines, {{display_line, 'SweepAddition'}})

        table.insert(@extmark_ids, api.nvim_buf_set_extmark(bufnr, @ns_id, anchor, 0, {
            virt_lines: virt_lines
            virt_lines_above: above
            hl_mode: 'combine'
        }))

    -- ---------------------------------------------------------------
    -- Common
    -- ---------------------------------------------------------------
    hide: () =>
        return unless @visible or #@extmark_ids > 0 or @mode
        if @current_bufnr and api.nvim_buf_is_valid(@current_bufnr)
            for _, id in ipairs(@extmark_ids)
                pcall(api.nvim_buf_del_extmark, @current_bufnr, @ns_id, id)
        elseif #@extmark_ids > 0
            pcall(api.nvim_buf_clear_namespace, 0, @ns_id, 0, -1)

        @extmark_ids = {}
        @mode = nil
        @current_completion = nil
        @current_context = nil
        @current_updated_lines = nil
        @current_diff = nil
        @current_bufnr = nil
        @current_line = nil
        @current_col = nil
        @visible = false

    -- Get data needed for acceptance
    get_completion_data: () =>
        return nil unless @visible
        if @mode == 'fim'
            return { mode: 'fim', completion: @current_completion, context: @current_context }
        elseif @mode == 'edit'
            return { mode: 'edit', updated_lines: @current_updated_lines, context: @current_context }
        return nil

    has_completion: () => @visible

    has_cursor_prediction: () => @visible and @mode == 'edit'

    should_hide_for_blink: () =>
        return false unless @config.blink.enabled
        return @blink_menu_visible

    setup_blink_listeners: () =>
        return unless @config.blink.enabled

        -- Own group, cleared on re-setup so :SweepReload doesn't stack
        -- listeners bound to stale instances
        group = api.nvim_create_augroup('sweep_blink', { clear: true })

        api.nvim_create_autocmd('User', {
            group: group
            pattern: 'BlinkCmpMenuOpen'
            callback: ->
                @blink_menu_visible = true
                @hide()
        })

        api.nvim_create_autocmd('User', {
            group: group
            pattern: 'BlinkCmpMenuClose'
            callback: ->
                @blink_menu_visible = false
        })

        api.nvim_create_autocmd('User', {
            group: group
            pattern: 'BlinkCmpAccept'
            callback: ->
                @blink_menu_visible = false
                @hide()
        })
