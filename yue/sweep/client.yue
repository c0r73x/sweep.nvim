-- Sweep client: builds prompts, streams completions from llama-server
-- (/completion, server-sent events) and post-processes them.
-- Supports FIM (inline completion) and edit (next-edit prediction) modes.

http = require('sweep.http')
post = require('sweep.postprocess')
Server = require('sweep.server')

FIM_STOP = {
    '<|endoftext|>', '<|file_sep|>', '</s>',
    '<|fim_prefix|>', '<|fim_suffix|>', '<|fim_middle|>'
}
EDIT_STOP = {'<|file_sep|>', '</s>'}

-- Pull a readable message out of an error response body
error_message = (status, body) ->
    ok, obj = pcall(vim.json.decode, body or '')
    if ok and type(obj) == 'table' and type(obj.error) == 'table'
        return "HTTP #{status}: #{obj.error.message}"
    "HTTP #{status}"

export default class SweepClient
    new: (config) =>
        @config = config
        @server = Server(config)
        @connected = false  -- last request reached the server
        @abort = nil        -- aborts the in-flight completion
        @generation = 0     -- bumped by cancel(); stale work checks it

    -- ---------------------------------------------------------------
    -- Logging
    -- ---------------------------------------------------------------
    log: (msg, level) =>
        log_level = @config and @config.log_level or 'info'
        if log_level == 'debug' or (level and level >= vim.log.levels.WARN)
            pcall(vim.notify, "Sweep: #{msg}", level or vim.log.levels.INFO)

    is_debug: () => @config and @config.log_level == 'debug'

    -- ---------------------------------------------------------------
    -- Connection
    -- ---------------------------------------------------------------

    -- Abort the in-flight completion; its callback gets "Cancelled".
    -- Closing the connection makes llama-server stop generating.
    cancel: () =>
        @generation += 1
        if @abort
            abort = @abort
            @abort = nil
            abort()

    disconnect: () => @cancel()

    -- Make sure the server is up (starting it if managed) and report
    health_check: (callback) =>
        @server\ensure((ok, err) ->
            @connected = ok
            if ok
                @log("llama-server ready (#{@server\describe()})")
            else
                @log(err, vim.log.levels.WARN)
            callback(ok, err) if callback
        )

    -- ---------------------------------------------------------------
    -- Completion
    -- ---------------------------------------------------------------

    -- callback(result, err): FIM gives a string, edit a list of lines
    -- (the window with nearby changes applied); nil, nil = no suggestion
    request_completion: (mode, context, tracker, callback) =>
        return callback(nil, "No context") unless context and callback

        mode = mode or 'fim'
        provider = @config.provider

        local prompt, stop, n_predict, timeout
        if mode == 'fim'
            prompt = @build_fim_prompt(context)
            stop = FIM_STOP
            n_predict = provider.fim_max_tokens or 128
            timeout = provider.completion_timeout or 5000
        else
            prompt = @build_edit_prompt(context, tracker)
            stop = EDIT_STOP
            -- The output repeats the whole window: never cut it short
            -- (~3 chars per token, plus room for added lines)
            window_chars = #table.concat(context.current_lines or {}, '\n')
            n_predict = math.max(provider.max_tokens or 512, math.ceil(window_chars / 3) + 64)
            timeout = provider.edit_timeout or 15000

        unless prompt
            -- Edit mode returns nil when there is no edit signal
            return callback(nil, if mode == 'edit' then nil else "Failed to build prompt")

        body = vim.json.encode({
            prompt: prompt
            n_predict: n_predict
            temperature: provider.temperature
            top_p: provider.top_p
            top_k: provider.top_k
            repeat_penalty: provider.repeat_penalty
            stop: stop
            stream: true
            cache_prompt: true
        })

        -- One request in flight per Neovim: a new one supersedes the old
        @cancel()
        @log("Requesting #{mode} completion (prompt #{#prompt} chars)")
        @_send(mode, body, timeout, context, callback, true)

    _send: (mode, body, timeout, context, callback, may_start) =>
        generation = @generation
        scope = mode == 'fim' and @fim_scope(context) or nil

        parts = {}
        final = nil         -- last event (has stop_type and timings)
        early = false       -- we stopped the stream ourselves
        on_event = (obj) ->
            if obj.error
                final = obj
                return true
            table.insert(parts, obj.content or '')
            if obj.stop
                final = obj
                return true
            if mode == 'fim' and post.fim_should_stop(table.concat(parts), scope)
                early = true
                return true
            false

        local abort
        abort = http.request(vim.tbl_extend('force', @server\endpoint(), {
            method: 'POST'
            path: '/completion'
            body: body
            timeout: timeout
            on_event: on_event
        }), (err, status, raw) ->
            @abort = nil if @abort == abort
            return callback(nil, 'Cancelled') if generation ~= @generation

            -- Server not running (idle stop, crash) or still loading:
            -- start it / wait for it, then try once more
            if may_start and ((err and err\match('^Connect')) or status == 503)
                @connected = false
                @server\ensure((ok, serr) ->
                    return callback(nil, 'Cancelled') if generation ~= @generation
                    return callback(nil, serr) unless ok
                    @connected = true
                    @_send(mode, body, timeout, context, callback, false)
                )
                return

            return callback(nil, err) if err
            @connected = true
            return callback(nil, error_message(status, raw)) unless status == 200
            if final and final.error
                return callback(nil, error_message(final.error.code or status, vim.json.encode(final)))

            text = table.concat(parts)
            truncated = early or (final and final.stop_type == 'limit') or false
            if @is_debug() and final and final.timings
                t = final.timings
                @log(string.format("%s: prompt %d tok %.0fms, gen %d tok %.0fms, draft %s/%s%s",
                    mode, t.prompt_n or 0, t.prompt_ms or 0, t.predicted_n or 0, t.predicted_ms or 0,
                    t.draft_n_accepted or '-', t.draft_n or '-', truncated and ' (truncated)' or ''))

            if mode == 'fim'
                result = post.post_process_fim(text, truncated, scope)
                return callback(#result > 0 and result or nil, nil)

            proximity = @config.provider.edit_proximity or 8
            lines = post.post_process_edit(text, truncated, context.current_lines,
                context.cursor_offset or 0, proximity)
            callback(lines, nil)
        )
        @abort = abort

    -- ---------------------------------------------------------------
    -- FIM Prompt: inline completion at cursor
    -- Uses the full trimmed window (lines before + after cursor)
    -- to match the original sweep.nvim format
    -- ---------------------------------------------------------------
    build_fim_prompt: (context) =>
        current_lines = context.current_lines or {}
        cursor_offset = context.cursor_offset or 0
        current_line = context.line_content or ''
        cursor_col = context.cursor_col or 0

        before_cursor = string.sub(current_line, 1, cursor_col)
        after_cursor = string.sub(current_line, cursor_col + 1)

        -- Build prefix: all window lines before cursor + text before cursor
        prefix_parts = {}
        for i = 1, cursor_offset
            table.insert(prefix_parts, current_lines[i])
        table.insert(prefix_parts, before_cursor)
        prefix = table.concat(prefix_parts, "\n")

        -- Build suffix: text after cursor + all window lines after cursor
        suffix_parts = {after_cursor}
        for i = cursor_offset + 2, #current_lines
            table.insert(suffix_parts, current_lines[i])
        suffix = table.concat(suffix_parts, "\n")

        "<|fim_prefix|>#{prefix}<|fim_suffix|>#{suffix}<|fim_middle|>"

    -- Where FIM output may end (postprocess.fim_scope): from the cursor
    -- line and the window lines below it
    fim_scope: (context) =>
        current_lines = context.current_lines or {}
        line = context.line_content or ''
        col = context.cursor_col or 0
        below = [l for l in *current_lines[(context.cursor_offset or 0) + 2, #current_lines]]
        post.fim_scope(line\sub(1, col), line\sub(col + 1), below, @config.provider.max_fim_lines or 8)

    -- ---------------------------------------------------------------
    -- Edit Prompt: next-edit prediction with diff context
    -- Format matches: https://blog.sweep.dev/posts/oss-next-edit
    -- ---------------------------------------------------------------
    build_edit_prompt: (context, tracker) =>
        parts = {}
        filepath = context.filepath or 'buffer'

        cwd = vim.fn.getcwd()
        if filepath\sub(1, #cwd) == cwd
            filepath = filepath\sub(#cwd + 2)

        original_lines = context.original_lines or {}
        current_lines = context.current_lines or {}

        -- Recent edits, minus those to this buffer since the original
        -- snapshot (they are the original -> current change below)
        diff_sections = tracker and tracker\get_diff_sections(context.bufnr, context.original_tick) or {}

        -- Check if there's any edit signal for the model to work with
        has_diff_history = #diff_sections > 0
        has_buffer_changes = false
        if #original_lines == #current_lines
            for i = 1, #original_lines
                if original_lines[i] ~= current_lines[i]
                    has_buffer_changes = true
                    break
        else
            has_buffer_changes = true

        -- Without any edit there is nothing to predict from: the model
        -- just copies the window back, so skip the request
        return nil unless has_diff_history or has_buffer_changes

        -- 1. Context files from recently visited buffers
        if tracker
            ctx_files = tracker\get_context_files(context.bufnr)
            for _, cf in ipairs(ctx_files)
                table.insert(parts, "<|file_sep|>#{cf.filepath}")
                for _, line in ipairs(cf.lines)
                    table.insert(parts, line)

        -- 2. Recent edit diffs
        for _, section in ipairs(diff_sections)
            table.insert(parts, section)

        -- 3. Treesitter context (enclosing scope + imports)
        ts_context = @get_treesitter_context(context)
        if ts_context
            table.insert(parts, "<|file_sep|>context/treesitter")
            table.insert(parts, ts_context)

        -- 4. Original window
        if #original_lines > 0
            table.insert(parts, "<|file_sep|>original/#{filepath}")
            for _, line in ipairs(original_lines)
                table.insert(parts, line)

        -- 5. Current code block
        if #current_lines > 0
            table.insert(parts, "<|file_sep|>current/#{filepath}")
            for _, line in ipairs(current_lines)
                table.insert(parts, line)

        -- 6. Updated section for model to generate
        table.insert(parts, "<|file_sep|>updated/#{filepath}")

        return table.concat(parts, '\n')

    -- Get treesitter context: enclosing scope signature + imports
    get_treesitter_context: (context) =>
        bufnr = context.bufnr
        return nil unless bufnr and vim.api.nvim_buf_is_valid(bufnr)

        ok, parser = pcall(vim.treesitter.get_parser, bufnr)
        return nil unless ok and parser

        ok2, tree = pcall(-> parser\parse())
        return nil unless ok2 and tree and tree[1]

        root = tree[1]\root()
        return nil unless root

        line_num = context.line_num or 1
        col = context.cursor_col or 0

        parts = {}

        -- Find enclosing scope (function/method/class)
        node = root\named_descendant_for_range(line_num - 1, col, line_num - 1, col)
        scope_types = {
            'function_declaration': true, 'function_definition': true
            'method_declaration': true, 'method_definition': true
            'class_declaration': true, 'class_definition': true
            'function_item': true, 'impl_item': true
        }

        current = node
        while current
            ntype = current\type()
            if scope_types[ntype]
                start_row = current\start()
                scope_line = vim.api.nvim_buf_get_lines(bufnr, start_row, start_row + 1, false)[1]
                if scope_line
                    table.insert(parts, "Enclosing scope: #{scope_line}")
                break
            current = current\parent()

        -- Collect import lines from top of file
        lines = vim.api.nvim_buf_get_lines(bufnr, 0, math.min(50, vim.api.nvim_buf_line_count(bufnr)), false)
        import_patterns = {'^import ', '^from ', '^require', '^use ', '^#include', '^using '}
        for _, line in ipairs(lines)
            for _, pat in ipairs(import_patterns)
                if line\match(pat)
                    table.insert(parts, "Import: #{line}")
                    break

        return #parts > 0 and table.concat(parts, '\n') or nil

