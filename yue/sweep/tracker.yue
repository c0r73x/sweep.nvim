-- Edit History Tracker
-- Tracks buffer changes via nvim_buf_attach to build diff context for the
-- sweep-next-edit prompt. Also tracks recently visited buffers for context.

api = vim.api

-- Edits to the same lines within this window are merged into one history
-- entry, so typing a word doesn't fill the history with one entry per key
COALESCE_NS = 1e9

-- Bigger changes (pastes, deleting a block, :%s) say little about the next
-- edit and would crowd the model's context, so they aren't recorded
MAX_EDIT_LINES = 40

-- Replace snapshot[first+1 .. last] with new_lines in place
splice = (snapshot, first, last, new_lines) ->
    n = #snapshot
    delta = #new_lines - (last - first)
    if delta ~= 0 and last < n
        table.move(snapshot, last + 1, n, last + 1 + delta)
    if delta < 0
        for i = n + delta + 1, n
            snapshot[i] = nil
    for i = 1, #new_lines
        snapshot[first + i] = new_lines[i]
    -- Deleting every line reports 0 new lines, but a buffer always keeps
    -- one (empty) line
    snapshot[1] = '' if #snapshot == 0

lines_equal = (a, b) ->
    return false unless #a == #b
    for i = 1, #a
        return false unless a[i] == b[i]
    true

whitespace_only = (a, b) ->
    table.concat(a, '\n')\gsub('%s+', '') == table.concat(b, '\n')\gsub('%s+', '')

-- Whether a history entry touches any of the 1-indexed { lo, hi } spans
overlaps = (edit, spans) ->
    for s in *(spans or {})
        return true if edit.start_line <= s[2] and edit.end_line >= s[1]
    false

-- Path shown in the prompt: relative to cwd when inside it
rel_path = (bufnr) ->
    filepath = api.nvim_buf_get_name(bufnr)
    return "buffer_#{bufnr}" if #filepath == 0
    cwd = vim.fn.getcwd()
    if filepath\sub(1, #cwd) == cwd
        filepath = filepath\sub(#cwd + 2)
    filepath

-- Undo steps walked back at most when restoring the history
MAX_UNDO_STEPS = 50

-- Changes of the latest undo steps in the file's undofile, newest first,
-- as { start_line, old_lines, new_lines }. Read in a scratch buffer, so the
-- buffer's own undo state is untouched. {} without an undofile, or when it
-- belongs to other text (rundo then loads nothing).
undo_hunks = (bufnr, limit) ->
    path = api.nvim_buf_get_name(bufnr)
    return {} if #path == 0
    file = vim.fn.undofile(path)
    return {} if #file == 0 or vim.fn.filereadable(file) == 0
    lines = api.nvim_buf_get_lines(bufnr, 0, -1, false)
    hunks = {}
    ei = vim.o.eventignore
    vim.o.eventignore = 'all'
    scratch = api.nvim_create_buf(false, true)
    pcall(api.nvim_buf_call, scratch, ->
        -- Filling the buffer must not be an undo step of its own
        vim.bo.undolevels = -1
        api.nvim_buf_set_lines(scratch, 0, -1, false, lines)
        vim.bo.undolevels = math.max(vim.go.undolevels, MAX_UNDO_STEPS)
        vim.cmd('silent! rundo ' .. vim.fn.fnameescape(file))
        steps = 0
        while #hunks < limit * 3 and steps < MAX_UNDO_STEPS and vim.fn.undotree().seq_cur > 0
            newer = api.nvim_buf_get_lines(scratch, 0, -1, false)
            vim.cmd('silent! undo')
            older = api.nvim_buf_get_lines(scratch, 0, -1, false)
            steps += 1
            d = vim.diff(table.concat(older, '\n') .. '\n', table.concat(newer, '\n') .. '\n',
                { result_type: 'indices' })
            for h in *d
                table.insert(hunks, {
                    start_line: math.max(1, h[3])
                    old_lines: [older[i] for i = h[1], h[1] + h[2] - 1]
                    new_lines: [newer[i] for i = h[3], h[3] + h[4] - 1]
                })
    )
    pcall(api.nvim_buf_delete, scratch, { force: true })
    vim.o.eventignore = ei
    hunks

-- Uncommitted changes of the file (git diff against HEAD) as hunks like
-- undo_hunks, passed to callback on the main loop. Nothing is passed
-- outside a git work tree or without git.
git_hunks = (path, callback) ->
    cmd = { 'git', '-C', vim.fs.dirname(path), 'diff', '--no-color', '--no-ext-diff',
        '-U0', 'HEAD', '--', path }
    pcall(vim.system, cmd, { text: true }, (res) ->
        return unless res.code == 0
        hunks = {}
        local cur
        for line in *vim.split(res.stdout or '', '\n', { plain: true })
            c = line\match('^@@ %-%d+,?%d* %+(%d+),?%d* @@')
            if c
                cur = { start_line: math.max(1, tonumber(c)), old_lines: {}, new_lines: {} }
                table.insert(hunks, cur)
            elseif cur
                mark = line\sub(1, 1)
                table.insert(cur.old_lines, line\sub(2)) if mark == '-'
                table.insert(cur.new_lines, line\sub(2)) if mark == '+'
        vim.schedule(-> callback(hunks))
    )

-- History entry for a restored hunk; nil for changes the session would
-- not record either (no change, too big, whitespace only)
restored_entry = (bufnr, filepath, h) ->
    return nil if lines_equal(h.old_lines, h.new_lines)
    return nil if #h.old_lines > MAX_EDIT_LINES or #h.new_lines > MAX_EDIT_LINES
    return nil if whitespace_only(h.old_lines, h.new_lines)
    {
        bufnr: bufnr
        filepath: filepath
        start_line: h.start_line
        end_line: h.start_line + math.max(#h.old_lines, #h.new_lines, 1) - 1
        old_lines: h.old_lines
        new_lines: h.new_lines
        timestamp: 0
        -- Older than any original snapshot of this session
        tick: 0
    }

-- Trimmed non-blank lines of hunks, as a set
line_set = (hunks, key) ->
    set = {}
    for h in *hunks
        for l in *h[key]
            l = l\match('^%s*(.-)%s*$')
            set[l] = true if #l > 0
    set

covered_by = (h, old_set, new_set) ->
    any = false
    for pair in *{ { h.old_lines, old_set }, { h.new_lines, new_set } }
        for l in *pair[1]
            l = l\match('^%s*(.-)%s*$')
            continue if #l == 0
            any = true
            return false unless pair[2][l]
    any

export default class EditTracker
    config: nil
    max_edits: 6
    max_recent_files: 3
    context_file_lines: 60
    max_file_lines: 10000
    -- Per-buffer data
    attached_bufs: {}       -- bufnr -> true (already attached)
    line_snapshots: {}      -- bufnr -> {lines} (last-known line content for diff)
    -- bufnr -> the latest undo step made outside Insert mode (see step_before)
    last_steps: {}
    -- Global edit history (across buffers, most recent last)
    edit_history: {}
    -- Recently visited buffers (ordered, most recent last)
    recent_files: {}
    -- Set by shutdown(); buffer callbacks then detach themselves
    stopped: false

    new: (config) =>
        @config = config
        ctx = config.context or {}
        @max_edits = ctx.max_edit_history or 6
        @max_recent_files = ctx.max_context_files or 3
        @context_file_lines = ctx.context_file_lines or 60
        behavior = config.behavior or {}
        @max_file_lines = behavior.max_file_lines or 10000
        @ignore_ft = {}
        for ft in *(behavior.ignore_filetypes or {})
            @ignore_ft[ft] = true
        @attached_bufs = {}
        @line_snapshots = {}
        @last_steps = {}
        @edit_history = {}
        @recent_files = {}
        @stopped = false
        @restore = ctx.restore_history ~= false

    -- Attach to a buffer to track changes
    attach: (bufnr) =>
        bufnr = bufnr or api.nvim_get_current_buf()
        return if @stopped
        return if @attached_bufs[bufnr]
        return unless api.nvim_buf_is_valid(bufnr)
        return if vim.bo[bufnr].buftype ~= ''
        return if @ignore_ft[vim.bo[bufnr].filetype]
        -- Huge buffers are never completed, so don't pay for tracking them
        return if @max_file_lines > 0 and
            api.nvim_buf_line_count(bufnr) > @max_file_lines

        -- Snapshot the full content; kept in sync by splicing each change
        @line_snapshots[bufnr] = api.nvim_buf_get_lines(bufnr, 0, -1, false)

        self = @
        api.nvim_buf_attach(bufnr, false, {
            on_lines: (_, buf, tick, first_line, last_line, new_last_line, ...) ->
                -- Returning true detaches (after :SweepReload / shutdown)
                return true if self.stopped
                self\on_lines_changed(buf, first_line, last_line, new_last_line, tick)
                return

            -- :edit! etc. replace the whole text without on_lines
            on_reload: (_, buf) ->
                return true if self.stopped
                if self.line_snapshots[buf]
                    self.line_snapshots[buf] = api.nvim_buf_get_lines(buf, 0, -1, false)
                self.last_steps[buf] = nil
                return

            on_detach: (_, buf) ->
                return if self.stopped
                self.attached_bufs[buf] = nil
                self.line_snapshots[buf] = nil
                self.last_steps[buf] = nil
        })

        @attached_bufs[bufnr] = true
        vim.schedule(-> @restore_history(bufnr))

    -- Seed the history of a file opened in this session with changes from
    -- before it: the latest undo steps from its undofile, then uncommitted
    -- git changes those do not cover, while the history has room. They go
    -- before the session's own edits, oldest first.
    restore_history: (bufnr) =>
        return unless @restore and not @stopped and @attached_bufs[bufnr]
        return unless api.nvim_buf_is_valid(bufnr) and vim.bo[bufnr].buftype == ''
        path = api.nvim_buf_get_name(bufnr)
        return if #path == 0 or vim.fn.filereadable(path) == 0
        for e in *@edit_history
            return if e.bufnr == bufnr
        filepath = rel_path(bufnr)

        -- Put entries (oldest first) before the session's edits: the newest
        -- of them that fit the free slots, at least half the history.
        -- Over the cap, other buffers' oldest edits go first.
        prepend = (entries) ->
            keep = math.max(@max_edits - #@edit_history, math.ceil(@max_edits / 2))
            first = math.max(1, #entries - keep + 1)
            for i = first, #entries
                table.insert(@edit_history, i - first + 1, entries[i])
            i = 1
            while #@edit_history > @max_edits and i <= #@edit_history
                if @edit_history[i].bufnr ~= bufnr
                    table.remove(@edit_history, i)
                else
                    i += 1
            while #@edit_history > @max_edits
                table.remove(@edit_history, 1)

        undo = undo_hunks(bufnr, @max_edits)
        entries = {}
        for i = #undo, 1, -1
            h = undo[i]
            prev = entries[#entries]
            -- Successive drafts of the same lines are one change
            if prev and prev.start_line == h.start_line and lines_equal(prev.new_lines, h.old_lines)
                prev.new_lines = h.new_lines
            else
                table.insert(entries, { start_line: h.start_line, old_lines: h.old_lines, new_lines: h.new_lines })
        restored = {}
        for h in *entries
            e = restored_entry(bufnr, filepath, h)
            table.insert(restored, e) if e
        prepend(restored)

        old_set, new_set = line_set(undo, 'old_lines'), line_set(undo, 'new_lines')
        git_hunks(path, (hunks) ->
            return if @stopped or not @attached_bufs[bufnr]
            git = {}
            for h in *hunks
                continue if covered_by(h, old_set, new_set)
                e = restored_entry(bufnr, filepath, h)
                table.insert(git, e) if e
            prepend(git)
        )

    -- Stop tracking: attached buffer callbacks detach on their next event
    shutdown: () =>
        @stopped = true
        @attached_bufs = {}
        @line_snapshots = {}
        @last_steps = {}

    -- Called by nvim_buf_attach when lines change
    -- first_line, last_line: 0-indexed range of OLD lines that were replaced
    -- new_last_line: 0-indexed end of the NEW replacement range
    -- tick: the buffer's changedtick after the change
    on_lines_changed: (bufnr, first_line, last_line, new_last_line, tick) =>
        snapshot = @line_snapshots[bufnr]
        return unless snapshot

        -- Extract old lines from our snapshot
        old_lines = {}
        for i = first_line + 1, last_line
            table.insert(old_lines, snapshot[i] or '')

        -- Read only the replacement lines and keep the snapshot in sync,
        -- even for changes that aren't recorded below
        new_lines = api.nvim_buf_get_lines(bufnr, first_line, new_last_line, false)
        splice(snapshot, first_line, last_line, new_lines)
        @record_step(bufnr, first_line, old_lines, #new_lines, tick)

        -- Skip trivial changes (identical content) and big ones
        return if lines_equal(old_lines, new_lines)
        return if #old_lines > MAX_EDIT_LINES or #new_lines > MAX_EDIT_LINES

        now = vim.uv.hrtime()

        -- Merge into the previous entry when this change rewrites exactly
        -- the lines that entry produced (e.g. typing on one line)
        last = @edit_history[#@edit_history]
        if last and last.bufnr == bufnr and
                last.start_line == first_line + 1 and
                #last.new_lines == #old_lines and
                now - last.timestamp < COALESCE_NS
            if lines_equal(last.old_lines, new_lines)
                -- Change was undone: nothing left to report
                table.remove(@edit_history)
            else
                last.new_lines = new_lines
                last.end_line = first_line + math.max(#last.old_lines, #new_lines)
                last.timestamp = now
                last.tick = tick
            return

        -- Skip whitespace-only changes
        return if whitespace_only(old_lines, new_lines)

        -- Record the edit
        filepath = rel_path(bufnr)

        edit = {
            bufnr: bufnr
            filepath: filepath
            start_line: first_line + 1  -- 1-indexed for prompt
            end_line: first_line + math.max(#old_lines, #new_lines)
            old_lines: old_lines
            new_lines: new_lines
            timestamp: now
            tick: tick
        }

        table.insert(@edit_history, edit)

        -- Trim to MAX_EDITS
        while #@edit_history > @max_edits
            table.remove(@edit_history, 1)

    -- c, s, C, S, o and O change the text before Insert mode starts, so
    -- the snapshot taken at InsertEnter already lacks the replaced word or
    -- has the opened line. Changes made outside Insert mode are kept per
    -- undo step (changenr()); the typed text joins that step when the
    -- insert continues the change.
    record_step: (bufnr, first_line, old_lines, count, tick) =>
        if api.nvim_get_mode().mode\match('^[iR]')
            -- Typed text: keeps the step, but it can no longer be reverted
            step = @last_steps[bufnr]
            step.last_tick = nil if step
            return
        unless bufnr == api.nvim_get_current_buf()
            @last_steps[bufnr] = nil
            return
        seq = vim.fn.changenr()
        step = @last_steps[bufnr]
        unless step and step.seq == seq
            -- tick: the changedtick before the step
            step = { seq: seq, tick: tick - 1, changes: {} }
            @last_steps[bufnr] = step
        table.insert(step.changes, { first: first_line, old_lines: old_lines, count: count })
        step.last_tick = tick

    -- The text before the latest undo step made outside Insert mode, when
    -- that step is the last change to the buffer: { seq, tick, lines },
    -- seq being its undo number and tick the changedtick before it.
    -- Otherwise nil.
    step_before: (bufnr) =>
        step = @last_steps[bufnr]
        return nil unless step and step.last_tick == api.nvim_buf_get_changedtick(bufnr)
        lines = api.nvim_buf_get_lines(bufnr, 0, -1, false)
        for i = #step.changes, 1, -1
            c = step.changes[i]
            splice(lines, c.first, c.first + c.count, c.old_lines)
        { seq: step.seq, tick: step.tick, lines: lines }

    -- Track buffer visit for recent files context
    track_visit: (bufnr) =>
        bufnr = bufnr or api.nvim_get_current_buf()
        return unless api.nvim_buf_is_valid(bufnr)
        return if vim.bo[bufnr].buftype ~= ''

        filepath = api.nvim_buf_get_name(bufnr)
        return if #filepath == 0

        -- Remove existing entry for this buffer (will re-add at end)
        for i = #@recent_files, 1, -1
            if @recent_files[i].bufnr == bufnr
                table.remove(@recent_files, i)

        -- Get cursor position for context centering
        pos = api.nvim_win_get_cursor(0)

        table.insert(@recent_files, {
            bufnr: bufnr
            filepath: filepath
            cursor_line: pos[1]
        })

        -- Trim to MAX_RECENT_FILES (excluding current buffer)
        while #@recent_files > @max_recent_files + 1
            table.remove(@recent_files, 1)

    -- Remember where the cursor was when leaving a buffer, so its context
    -- chunk is centered there
    track_leave: (bufnr) =>
        return unless api.nvim_buf_is_valid(bufnr)
        line = api.nvim_win_get_cursor(0)[1]
        for entry in *@recent_files
            entry.cursor_line = line if entry.bufnr == bufnr

    -- Buffer wiped out: drop it from the recent files
    forget: (bufnr) =>
        @last_steps[bufnr] = nil
        for i = #@recent_files, 1, -1
            table.remove(@recent_files, i) if @recent_files[i].bufnr == bufnr

    -- Get formatted diff sections for the sweep prompt
    -- Returns list of strings, each a complete <|file_sep|>...original:...updated: block
    -- Edits to bufnr made after its changedtick since_tick are left out: the
    -- prompt already shows them as original -> current, and the model reads
    -- a change that is also in the history as done, predicting nothing.
    -- Edits to bufnr touching skip_spans (lines changed since the original)
    -- are left out too: older drafts of those lines read as a pattern to
    -- go back to.
    get_diff_sections: (bufnr, since_tick, skip_spans) =>
        sections = {}
        for _, edit in ipairs(@edit_history)
            continue if since_tick and edit.bufnr == bufnr and
                edit.tick and edit.tick > since_tick
            continue if edit.bufnr == bufnr and overlaps(edit, skip_spans)
            parts = {}
            table.insert(parts, "<|file_sep|>#{edit.filepath}.diff")
            table.insert(parts, "original:")
            for _, line in ipairs(edit.old_lines)
                table.insert(parts, line)
            table.insert(parts, "updated:")
            for _, line in ipairs(edit.new_lines)
                table.insert(parts, line)
            table.insert(sections, table.concat(parts, '\n'))
        return sections

    -- Get context file chunks from recently visited buffers
    -- Excludes the current buffer (which is handled separately in the prompt)
    get_context_files: (exclude_bufnr) =>
        chunks = {}
        for _, entry in ipairs(@recent_files)
            continue if entry.bufnr == exclude_bufnr
            continue unless api.nvim_buf_is_valid(entry.bufnr)

            filepath = entry.filepath
            cwd = vim.fn.getcwd()
            if filepath\sub(1, #cwd) == cwd
                filepath = filepath\sub(#cwd + 2)

            total_lines = api.nvim_buf_line_count(entry.bufnr)

            if total_lines <= @context_file_lines
                -- Small file: include entirely
                lines = api.nvim_buf_get_lines(entry.bufnr, 0, -1, false)
                table.insert(chunks, {
                    filepath: filepath
                    lines: lines
                })
            else
                -- Large file: center around last cursor position
                center = entry.cursor_line or 1
                half = math.floor(@context_file_lines / 2)
                start_line = math.max(0, center - half - 1)
                end_line = math.min(total_lines, start_line + @context_file_lines)
                lines = api.nvim_buf_get_lines(entry.bufnr, start_line, end_line, false)
                table.insert(chunks, {
                    filepath: filepath
                    lines: lines
                })

        return chunks

    -- Earlier versions of lines in bufnr's history: trimmed line -> list of
    -- the trimmed lines it was edited from. Only line-for-line edits count.
    line_versions: (bufnr) =>
        versions = {}
        for e in *@edit_history
            continue unless e.bufnr == bufnr and #e.old_lines == #e.new_lines
            for i = 1, #e.new_lines
                old = e.old_lines[i]\match('^%s*(.-)%s*$')
                new = e.new_lines[i]\match('^%s*(.-)%s*$')
                continue if old == new or #new == 0
                versions[new] = versions[new] or {}
                table.insert(versions[new], old)
        versions

    -- Full cleanup
    clear: () =>
        @attached_bufs = {}
        @line_snapshots = {}
        @last_steps = {}
        @edit_history = {}
        @recent_files = {}
