[Unit]
Description=Sweep AI Code Completion Proxy
After=network.target

# User unit: install to ~/.config/systemd/user/ and adjust the paths below
# if the plugin isn't installed by lazy.nvim (%h is your home directory).
# The proxy writes its own log to ~/.local/state/sweep-proxy.log (SWEEP_LOG).

[Service]
Type=simple
WorkingDirectory=%h/.local/share/nvim/lazy/sweep.nvim/proxy
ExecStart=/usr/bin/python3 %h/.local/share/nvim/lazy/sweep.nvim/proxy/sweep_proxy.py
Restart=on-failure
RestartSec=5

# Environment
Environment="PATH=/usr/bin:/bin:/usr/local/bin"
# Don't exit when idle: systemd owns the lifetime here
Environment="SWEEP_IDLE_TIMEOUT=0"
# Environment="MODEL_PATH=%h/path/to/sweep-next-edit-1.5b.q8_0.v2.gguf"

[Install]
WantedBy=default.target
